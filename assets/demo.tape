# Regenerate with: vhs assets/demo.tape  (requires a configured cliarr and `cargo build --release`)
Output assets/demo.gif

Set FontSize 15
Set Width 1200
Set Height 720
Set Padding 12
Set Theme "Catppuccin Mocha"
Set TypingSpeed 70ms

Hide
Type "export PATH=$PWD/target/release:$PATH CLIARR_NO_UPDATE_CHECK=1 && clear"
Enter
Show

Type "cliarr dune"
Sleep 800ms
Enter
Sleep 4s

Down
Sleep 500ms
Down
Sleep 500ms
Down
Sleep 1.2s

Escape
Sleep 500ms

Type "2"
Sleep 2.5s

Type "3"
Sleep 2.5s
Right
Sleep 2s

Type "4"
Sleep 2.5s

Type "1"
Sleep 1.5s
